use std::io::*;
use std::fs::*;
use std::env::Args;
use std::fmt::*;
use alloc::vec::*;
#include "lexer.shyh"

fn scanner_start(const char *source);
fn scanner_next(void) -> Token;
fn scanner_stop(void);

// 我们应该处理 mycc [filename] (-o [filename2])
fn main(Args args)->int{
    let len=args.len();
    //报错
    if (len < 2 || len == 3 || (len == 4 && !args.has_flag("-o"))) {
        eprintln("usage: mycc <input> [-o <output>]");
        return 1;
    }
    let input_file=args.get(1).unwrap();
    let mut output_file=Str::from_cstr("a.out");
    if (len == 4){
        output_file = args.value_of("-o").unwrap();
    }
    //读取
    let res=read_to_string(input_file);
    if (res.is_err()){
    eprintln("error: cannot read file {}, no such file", input_file);
    return 1;
    }
    //自动清理String内存
    defer let source = res.unwrap();
    let p=Scanner::new(source.as_str());
    scanner_start(p.source.data);
    let v=p.scan();
    scanner_stop();
    //这一节就到这里...
    println!("{:?}",v);
    return 0;
}

impl Debug for Token{
    fn debug(const self *t, WriterRef *out) -> int {
        if (t.type() == Token::Keyword) return write!(out, "Keyword({})", t.Keyword);
        if (t.type() == Token::Symbol) return write!(out, "Symbol({})", t.Symbol);
        if (t.type() == Token::Number) return write!(out, "Number({:?})", t.Number);
        if (t.type() == Token::String) return write!(out, "String({:?})", t.String);
        if (t.type() == Token::Operator) return write!(out, "Operator({})", t.Operator);
        if (t.type() == Token::Punct) return write!(out, "Punct({:?})", t.Punct);
        return write!(out, "Eof");
    }
}

struct Scanner{
    Str source;
};
impl Scanner{
    fn new(Str source)->Scanner{
        Scanner p;
        p.source = source;
        return p;
    }
    fn scan(self*)->Vec<Token>
    {
        Vec<Token> tokens = {0};
        while (1) {
            Token token = scanner_next();
            tokens.push(token);
            if (token.type() == Token::Eof) return tokens;
        }
    }
}
