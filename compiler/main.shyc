use std::io::*;
use std::fs::*;
use std::env::Args;
use std::fmt::*;
use alloc::vec::*;
#include "lexer.shyh"
#include <stdlib.h>

// 我们应该处理 mycc [filename] (-o [filename2])
fn main(Args args)->int{
    let len=args.len();
    //报错
    if (len < 2 || len == 3 || (len == 4 && !args.has_flag("-o"))) {
        eprintln("usage: mycc <input> [-o <output>]");
        return 1;
    }
    let input_file=args.get(1).unwrap();
    let mut output_file=Str::from_cstr("a.out");
    if (len == 4){
        output_file = args.value_of("-o").unwrap();
    }
    //读取
    let res=read_to_string(input_file);
    if (res.is_err()){
    eprintln("error: cannot read file {}, no such file", input_file);
    return 1;
    }
    //自动清理String内存
    defer let source = res.unwrap();
    let p=Scanner::new(source.as_str(), input_file);
    scanner_start(p.source.data);
    let mut v=p.scan();
    // 将 exp1 的 Token 数组交给语法分析器。
    let status = parse_program(&v, input_file);
    v.drop();
    scanner_stop();
    return status;
}

impl Debug for Token{
    fn debug(const self *t, WriterRef *out) -> int {
        if (t.type() == Token::Keyword) return write!(out, "Keyword({})", t.Keyword);
        if (t.type() == Token::Symbol) return write!(out, "Symbol({})", t.Symbol);
        if (t.type() == Token::Number) return write!(out, "Number({:?})", t.Number);
        if (t.type() == Token::String) return write!(out, "String({:?})", t.String);
        if (t.type() == Token::Operator) return write!(out, "Operator({})", t.Operator);
        if (t.type() == Token::Punct) return write!(out, "Punct({:?})", t.Punct);
        if (t.type() == Token::Unknown) return write!(out, "Unknown({:?})", t.Unknown);
        return write!(out, "Eof");
    }
}
enum ScannerState{
    CommentStart,
    CommentEnd,
    Other
};
ScannerState state = Other;
pub fn comment_start(){
    state=CommentStart;
}
pub fn comment_end(){
    state=CommentEnd;
}
struct Scanner{
    Str source;
    Str input_file;
};
impl Scanner{
    fn new(Str source, Str input_file)->Scanner{
        Scanner p;
        p.source = source;
        p.input_file = input_file;
        state=Other;
        return p;
    }
    fn scan(self*)->Vec<Token>
    {
        let scanner = self;
        Vec<Token> tokens = {0};
        while (1) {
            Token token = scanner_next();
            switch(state){
            /*为了处理块注释，需要一个简单地状态机*/
            case CommentStart:{
                if (token.type() == Token::Eof) {
                    /*注释写了一半没有闭合*/
                    int line = comment_start_line();
                    int column = comment_start_column();
                    eprintln("{}:{}:{}: error: unclosed block comment",
                        scanner.input_file, line, column);
                    exit(1);
                }
            }
            case CommentEnd:{
                /*退出了*/
                state=Other;
            }
            case Other:{
                tokens.push(token);
                if (token.type() == Token::Eof) return tokens;
                if (token.type() == Token::Unknown) {
                    eprintln("{}:{}:{}: error: illegal character '{}'",
                        scanner.input_file,
                        scanner_line(),
                        scanner_column()-1,
                        token.Unknown);
                    exit(1);
                }
                break;
            }
            default:
                {
                    eprintln(
                        "{}:{}:{}: error: Unknown Scanner State:{}",
                        scanner.input_file,
                        scanner_line(),
                        scanner_column(),
                        (int)state
                    );
                    break;
                }
            }
        }
    }
}
