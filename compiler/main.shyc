use std::io::*;
use std::fs::*;
use std::env::Args;
use std::fmt::*;
use alloc::vec::*;
#include "lexer.shyh"
#include <stdlib.h>

// 我们应该处理 mycc [filename] (-o [filename2])
fn main(Args args)->int{
    let len=args.len();
    //报错
    if (len < 2 || len == 3 || (len == 4 && !args.has_flag("-o"))) {
        eprintln("usage: mycc <input> [-o <output>]");
        return 1;
    }
    let input_file=args.get(1).unwrap();
    let mut output_file=Str::from_cstr("a.out");
    if (len == 4){
        output_file = args.value_of("-o").unwrap();
    }
    //读取
    let res=read_to_string(input_file);
    if (res.is_err()){
    eprintln("error: cannot read file {}, no such file", input_file);
    return 1;
    }
    //自动清理String内存
    defer let source = res.unwrap();
    defer SourceManager sources = scan(source.as_str(), input_file);
    // 将源文件和 Token 一起交给语法分析器。
    let status = parse_program(&sources);
    return status;
}

enum ScannerState{
    CommentStart,
    CommentEnd,
    Other
};
ScannerState state = Other;
pub fn comment_start(){
    state=CommentStart;
}
pub fn comment_end(){
    state=CommentEnd;
}

impl Scanner {
    fn new(const char *source) -> Scanner {
        scanner_start(source);
        Scanner scanner = {1};
        return scanner;
    }

    fn drop(self *scanner) {
        if (scanner.active) {
            scanner_stop();
            scanner.active = 0;
        }
    }
}

pub fn scan(Str text, Str input_path) -> SourceManager {
    SourceManager sources;
    sources.text = text;
    sources.input_path = input_path;
    Vec<usize> line_starts = {0};
    line_starts.push(0);
    for (usize i = 0; i < text.len; i++) {
        if (text.data[i] == '\n') line_starts.push(i + 1);
    }
    sources.line_starts = line_starts;
    Vec<TokenLoc> tokens = {0};
    sources.tokens = tokens;
    state = Other;
    defer Scanner scanner = Scanner::new(text.data);
    while (1) {
        TokenLoc location = scanner_next_loc();
        Token token = location.t;
        switch(state){
        /*为了处理块注释，需要一个简单地状态机*/
        case CommentStart:{
            if (token.type() == Token::Eof) {
                /*注释写了一半没有闭合*/
                int line = comment_start_line();
                int column = comment_start_column();
                eprintln("{}:{}:{}: error: unclosed block comment",
                    sources.input_path, line, column);
                exit(1);
            }
        }
        case CommentEnd:{
            /*退出了*/
            state=Other;
        }
        case Other:{
            sources.tokens.push(location);
            if (token.type() == Token::Eof) return sources;
            if (token.type() == Token::Unknown) {
                eprintln("{}:{}:{}: error: illegal character '{}'",
                    sources.input_path,
                    scanner_line(),
                    scanner_column()-1,
                    sources.token_text(location));
                exit(1);
            }
            break;
        }
        default:
            {
                eprintln(
                    "{}:{}:{}: error: Unknown Scanner State:{}",
                    sources.input_path,
                    scanner_line(),
                    scanner_column(),
                    (int)state
                );
                break;
            }
        }
    }
    return sources;
}
