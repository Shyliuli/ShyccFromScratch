use std::io::*;
use std::fs::*;
use std::env::Args;
use std::fmt::*;
use alloc::vec::*;
#include "lexer.shyh"
#include <stdlib.h>

// 我们应该处理 mycc [filename] (-o [filename2])
fn main(Args args)->int{
    let len=args.len();
    //报错
    if (len < 2 || len == 3 || (len == 4 && !args.has_flag("-o"))) {
        eprintln("usage: mycc <input> [-o <output>]");
        return 1;
    }
    let input_file=args.get(1).unwrap();
    let mut output_file=Str::from_cstr("a.out");
    if (len == 4){
        output_file = args.value_of("-o").unwrap();
    }
    //读取
    let res=read_to_string(input_file);
    if (res.is_err()){
    eprintln("error: cannot read file {}, no such file", input_file);
    return 1;
    }
    //自动清理String内存
    defer let source = res.unwrap();
    let p=Scanner::new(source.as_str(), input_file);
    scanner_start(p.source.data);
    let v=p.scan();
    scanner_stop();
    //这一节就到这里...
    println!("{:?}",v);
    return 0;
}

impl Debug for Token{
    fn debug(const self *t, String *out) -> int {
        int start = out.len();
        switch (*t){
        case Token::Keyword:
            out.push_cstr("Keyword(");
            out.push_str(t.Keyword);
            out.push_cstr(")");
            break;
        case Token::Symbol:
            out.push_cstr("Symbol(");
            out.push_str(t.Symbol);
            out.push_cstr(")");
            break;
        case Token::Number:
            out.push_cstr("Number(");
            fmt_debug(t.Number, out);
            out.push_cstr(")");
            break;
        case Token::String:
            out.push_cstr("String(");
            fmt_debug(t.String, out);
            out.push_cstr(")");
            break;
        case Token::Operator:
            out.push_cstr("Operator(");
            out.push_str(t.Operator);
            out.push_cstr(")");
            break;
        case Token::Punct:
            out.push_cstr("Punct(");
            fmt_debug(t.Punct, out);
            out.push_cstr(")");
            break;
        case Token::Eof:
            out.push_cstr("Eof");
            break;
        case Token::Unknown:
            out.push_cstr("Unknown(");
            fmt_debug(t.Unknown, out);
            out.push_cstr(")");
            break;
        }
        return out.len() - start;
    }
}
enum ScannerState{
    CommentStart,
    CommentEnd,
    Other
};
ScannerState state = Other;
pub fn comment_start(){
    state=CommentStart;
}
pub fn comment_end(){
    state=CommentEnd;
}
struct Scanner{
    Str source;
    Str input_file;
};
impl Scanner{
    fn new(Str source, Str input_file)->Scanner{
        Scanner p;
        p.source = source;
        p.input_file = input_file;
        state=Other;
        return p;
    }
    fn scan(self*)->Vec<Token>
    {
        let scanner = self;
        Vec<Token> tokens = {0};
        while (1) {
            Token token = scanner_next();
            switch(state){
            /*为了处理块注释，需要一个简单地状态机*/
            case CommentStart:{
                switch (token) {
                    case Token::Eof:
                        /*注释写了一半没有闭合*/
                        int line = comment_start_line();
                        int column = comment_start_column();
                        eprintln("{}:{}:{}: error: unclosed block comment",
                            scanner.input_file, line, column);
                        exit(1);
                    default:
                        break;
                }
            }
            case CommentEnd:{
                /*退出了*/
                state=Other;
            }
            case Other:{
                tokens.push(token);
                switch (token) {
                    case Token::Eof:
                        return tokens;
                    case Token::Unknown: {
                        eprintln("{}:{}:{}: error: illegal character '{}'",
                            scanner.input_file,
                            scanner_line(),
                            scanner_column()-1,
                            token.Unknown);
                        exit(1);
                    }
                    default:
                        break;
                }
                break;
            }
            default:
                {
                    eprintln(
                        "{}:{}:{}: error: Unknown Scanner State:{}",
                        scanner.input_file,
                        scanner_line(),
                        scanner_column(),
                        (int)state
                    );
                    break;
                }
            }
        }
    }
}
