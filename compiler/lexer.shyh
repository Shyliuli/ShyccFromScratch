#ifndef LEXER_SHYH
#define LEXER_SHYH

#include <core/str.shyh>
#include <alloc/vec.shyh>

enum Token {
    Keyword(Str),
    Symbol(Str),
    Number(int),
    String(Str),
    Operator(Str),
    Punct(char),
    Eof,
    Unknown(Str),
};

fn scanner_start(const char *source);
fn scanner_next(void) -> Token;
/* 释放扫描器及 Token 字符串；调用后不能再读取这些 Token 的 Str。 */
fn scanner_stop(void);

fn comment_start();
fn comment_end();
fn comment_start_line(void) -> int;
fn comment_start_column(void) -> int;
fn scanner_line(void) -> int;
fn scanner_column(void) -> int;
fn parse_program(Vec<Token> *tokens, Str input_file) -> int;
#endif
